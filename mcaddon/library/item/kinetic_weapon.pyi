from .component import ItemComponent
from mcaddon.core.base import BaseModel, NumberRange

__all__ = ["ItemKineticWeaponComponent", "KineticEffectConditions"]

class KineticEffectConditions(BaseModel):
    max_duration: int = ...
    min_relative_speed: float = ...
    min_speed: float = ...

class ItemKineticWeaponComponent(ItemComponent):
    """
    [Info](https://learn.microsoft.com/en-us/minecraft/creator/reference/content/itemreference/examples/itemcomponents/minecraft_kinetic_weapon)
    """

    damage_conditions: KineticEffectConditions
    dismount_conditions: KineticEffectConditions
    knockback_conditions: KineticEffectConditions
    delay: int
    damage_modifier: float = ...
    damage_multiplier: float = ...

    hitbox_margin: float = ...
    reach: NumberRange = ...
    creative_reach: NumberRange = ...
